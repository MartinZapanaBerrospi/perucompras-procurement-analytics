/// Calendario de 2022-01-01 a 2026-09-30, en español.
table dim_fecha
	lineageTag: ed772073-3448-51db-87ea-bd18f410bafd
	dataCategory: Time

	column fecha
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 221d2a47-efab-553a-99ee-deffc0669b67
