		sourceColumn: ordinaria_sobre_umbral

		annotation SummarizationSetBy = Automatic

	partition fact_orden = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "fact_orden.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"orden", type text}, {"fecha", type date}, {"ruc_entidad", type text}, {"ruc_proveedor", type text}, {"catalogo_id", Int64.Type}, {"estado_id", type text}, {"gran_compra", Int64.Type}, {"igv", type number}, {"total", type number}, {"igv_exonerado", Int64.Type}, {"igv_parcial", Int64.Type}, {"atipico_alto", Int64.Type}, {"atipico_bajo", Int64.Type}, {"ordinaria_sobre_umbral", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
