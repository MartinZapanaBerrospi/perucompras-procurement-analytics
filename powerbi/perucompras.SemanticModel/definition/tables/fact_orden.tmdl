/// Una fila por orden de compra de bienes formalizada (2022-01 a 2026-09).
table fact_orden
	lineageTag: 3ab6db5a-3a9a-52d5-9fa6-6e3cc903f513

	column orden
		dataType: string
		isKey
		lineageTag: 7e49ca83-4442-53fe-89f4-86e4952bd1b7
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = Automatic

	column fecha
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy
		lineageTag: 5d0f383b-b4f0-5b93-bed4-826549143f07
		summarizeBy: none
		sourceColumn: fecha

		annotation SummarizationSetBy = Automatic

	column ruc_entidad
		dataType: string
		isHidden
		lineageTag: 695c590f-6fab-5f28-8e67-d5d931a0d5c0
