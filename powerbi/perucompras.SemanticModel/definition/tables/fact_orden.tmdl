		sourceColumn: ruc_entidad

		annotation SummarizationSetBy = Automatic

	column ruc_proveedor
		dataType: string
		isHidden
		lineageTag: 4f09b06c-cc4b-5b3b-aa49-108d9bb355b8
		summarizeBy: none
		sourceColumn: ruc_proveedor

		annotation SummarizationSetBy = Automatic

	column catalogo_id
		dataType: int64
		isHidden
		lineageTag: 3911b260-cd2f-509f-be06-8db607fe64c3
		summarizeBy: none
