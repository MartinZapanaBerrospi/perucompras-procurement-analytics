		summarizeBy: none
		sourceColumn: estado_id

		annotation SummarizationSetBy = Automatic

	/// 1 = Gran Compra; 0 = Compra ordinaria
	column gran_compra
		dataType: int64
		lineageTag: fb51adf4-8f1b-59f9-a930-b0d1fd72aea0
		summarizeBy: none
		sourceColumn: gran_compra

		annotation SummarizationSetBy = Automatic

	column igv
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: 6116db86-2fe7-57f2-81fa-a5066af18363
		summarizeBy: none
		sourceColumn: igv

		annotation SummarizationSetBy = Automatic

	column total
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: 95e658ff-0896-51c9-9bee-1c08ab73fd35
		summarizeBy: none
		sourceColumn: total

		annotation SummarizationSetBy = Automatic

	column igv_exonerado
		dataType: int64
		isHidden
		lineageTag: 41c22f99-8a9a-537b-8bd4-39c62e9fa149
		summarizeBy: none
		sourceColumn: igv_exonerado

		annotation SummarizationSetBy = Automatic

	column igv_parcial
		dataType: int64
		isHidden
		lineageTag: 4b69af79-e47a-5655-a14b-22644c51eb3e
		summarizeBy: none
		sourceColumn: igv_parcial

		annotation SummarizationSetBy = Automatic

	column atipico_alto
		dataType: int64
		isHidden
		lineageTag: 26f29c48-e011-57e2-9d1c-707b914a88d6
		summarizeBy: none
		sourceColumn: atipico_alto

