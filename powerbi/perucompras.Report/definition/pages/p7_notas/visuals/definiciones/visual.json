                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Orden: una orden de compra de bienes formalizada en los Catálogos Electrónicos.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1b1f24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Ticket mediano: monto de la orden típica; la mitad de las órdenes cuesta menos.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1b1f24"
                    }
